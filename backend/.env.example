# Copy this to .env and fill in your values
# NEVER commit .env to git

APP_NAME="Umrah & Hajj Platform API"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=GENERATE_A_STRONG_SECRET_KEY_HERE

# Database
DATABASE_URL=postgresql+asyncpg://umrah:umrah@localhost:5432/umrah_db
DATABASE_URL_SYNC=postgresql://umrah:umrah@localhost:5432/umrah_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio SMS
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# SendGrid Email
SENDGRID_API_KEY=SG...
FROM_EMAIL=noreply@umrahplatform.com

# S3 / R2 Storage
S3_BUCKET=umrah-platform
S3_REGION=us-east-1
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com  # uncomment for R2/MinIO

# Sentry
SENTRY_DSN=https://...@sentry.io/...
